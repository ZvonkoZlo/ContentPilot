{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=contentpilot;Username=contentpilot;Password=contentpilot"
  },
  "ObjectStorage": {
    "Bucket": "contentpilot",
    "ServiceUrl": "http://localhost:9000",
    "PublicServiceUrl": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "CreateBucketIfMissing": true,
    "MaxPresignedUrlLifetime": "00:15:00",
    "DefaultPresignedUrlLifetime": "00:15:00"
  },
  "Jobs": {
    "MaxAttempts": 3,
    "LeaseDuration": "00:05:00",
    "Consumers": 4,
    "PollInterval": "00:00:02",
    "RetryBaseDelay": "00:00:10",
    "RetryMaxDelay": "00:10:00",
    "ReaperInterval": "00:01:00"
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  },
  "Persistence": {
    "SensitiveDataLogging": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
