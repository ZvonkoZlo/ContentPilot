<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ContentPilot.Rendering.Contracts\ContentPilot.Rendering.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.17.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <!-- Fonts and manifests are runtime inputs: the renderer reads them from disk at
         startup so slot budgets can be tuned without a rebuild. JSON is already picked up
         by the default Content glob; only the update of its copy behaviour is needed. -->
    <Content Include="Fonts/**/*.woff2" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Templates/**/*.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
