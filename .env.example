# Copy to .env for docker compose. .env is git-ignored and never committed.
#
#   cp .env.example .env
#
# Nothing here is read unless you copy it. The defaults below are local development
# credentials with no value outside your machine; the API keys have no defaults on purpose.

# ---------------------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------------------

# Published on 5433 by default so a locally installed PostgreSQL on 5432 does not conflict.
POSTGRES_PORT=5433
POSTGRES_PASSWORD=contentpilot

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=contentpilot
MINIO_ROOT_PASSWORD=contentpilot-dev-secret

# Set this per agent when two people run the stack at once. See PARALLEL-WORK.md.
# COMPOSE_PROJECT_NAME=contentpilot

# ---------------------------------------------------------------------------------------
# Language models
# ---------------------------------------------------------------------------------------
# PUT YOUR API KEYS HERE. They are read as environment variables and never appear in
# appsettings.json, which is committed.
#
# You only need the key for the provider your profiles actually name. Profiles live in
# appsettings.json under "Ai:Profiles"; each one declares its own Provider, so a single
# campaign can use Anthropic for one agent and OpenAI for another.

# Anthropic — https://console.anthropic.com/settings/keys  (starts with sk-ant-)
Ai__Providers__Anthropic__ApiKey=

# OpenAI — https://platform.openai.com/api-keys  (starts with sk-)
Ai__Providers__OpenAi__ApiKey=

# The master switch. Nothing can spend a cent while this is false, whatever keys are set.
# Turn it on once you have added a key above.
Ai__Enabled=false

# Off | Record | Replay
#   Record  calls the provider and writes every response to disk
#   Replay  serves from disk and never calls the provider (how the tests run without a key)
Ai__Cassettes=Off

# Ceiling for one campaign, in micro-cents. 200000000 is $2.00.
Ai__CampaignBudgetMicroCents=200000000
